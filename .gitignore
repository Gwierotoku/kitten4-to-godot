# ============================================
# 开源内容 · .gitignore
# 目标：只保留项目源码与必需资源，剔除缓存、构建产物与备份
# ============================================

# ---- 浏览器 / Electron 运行缓存（约 172 MB，可由程序重新生成）----
_cache/
**/_cache/

# ---- 转换输出产物（约 58 MB，可重新转换生成）----
_out/
**/_out/
shots/
**/_shots/

# ---- 大型工程样本（体积大，不随仓库分发）----
# 已从仓库移除；保留此规则可避免以后误把大型 .bcm4 目录提交上去。
# 若将来确实要上报，删除下面两条即可。
大型项目/
**/大型项目/

# ---- 备份（约 38 MB）----
_backup/
**/_backup/
*.bak
*.bom_backup

# ---- 调试探针与验证工程的运行缓存 ----
_k4tmp_probe/
_k4verify/
**/.godot/

# ---- Node ----
node_modules/

# ---- 日志与临时文件 ----
*.log
*.tmp
dev/tmp/

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 环境变量与凭据（防止误传密钥）----
.env
.env.local
*.pem
*.key
