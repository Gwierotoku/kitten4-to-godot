bal":false,"scale":1,"theme":"common","value":0,"name":"遍历3","offset":{"x":0,"y":0},"position":{"x":-470,"y":-250},"current_entity":"ba90c49e-06c8-4586-8cf2-ba14bb57c8bb","visible":false},"56fe64ff-f327-4d39-aaa4-26f1aad99478":{"id":"56fe64ff-f327-4d39-aaa4-26f1aad99478","type":"any","is_global":true,"scale":1,"theme":"clock","value":0,"offset":{"x":0,"y":0},"position":{"x":-470,"y":-250},"visible":false,"name":"加成显示"},"01dc553f-7f25-4de6-8234-c827f7428da4":{"id":"01dc553f-7f25-4de6-8234-c827f7428da4","type":"any","is_global":false,"scale":1,"theme":"common","value":0,"name":"遍历4","offset":{"x":0,"y":0},"position":{"x":-470,"y":-250},"current_entity":"ba90c49e-06c8-4586-8cf2-ba14bb57c8bb","visible":false},"dc28120d-1682-493b-8485-74cb1b9d8cfe":{"id":"dc28120d-1682-493b-8485-74cb1b9d8cfe","type":"any","is_global":false,"scale":1,"theme":"common","value":0,"offset":{"x":0,"y":0},"position":{"x":-470,"y":-250},"current_entity":"ba90c49e-06c8-4586-8cf2-ba14bb57c8bb","visible":false,"name":"选项大小"},"9838b36b-aff3-4f74-b1cb-21bbe8a9aa2b":{"id":"9838b36b-aff3-4f74-b1cb-21bbe8a9aa2b","type":"list","is_global":true,"scale":1,"theme":"purple","name":"加成","offset":{"x":0,"y":0},"position":{"x":-470,"y":-250},"visible":false,"value":["生命提升&生命增加３０％&1","伤害提升&伤害增加３０％&1","减伤提升&减伤增加３０％&1","移速提升&移速增加２０&1","射速提升&射速增加２０&1","弹速提升&弹速增加２０&1","一针见血&２０％概率暴击敌人，造成２倍伤害&2","百发百中&消除子弹偏移&2","冲锋重击&５０％概率击退敌人&3","荆棘之甲&返还５０％受到的伤害&2","无阻飞弹&子弹可穿透敌人数增加１&2","幻影回旋&子弹可反弹墙体数增加１&2","力魄增幅&生命、伤害、减伤增加２４％&2","追风逐电&移速、射速、弹速增加１６&2","格局打开&静止不动时扩大视野&2","致命一击&５％概率暴击敌人，造成１０倍伤害&3&7","满血复活&生命增加７５％并回满血量&3","暴风战锤&伤害、减伤增加３０％，移速减少２０&2","狂暴药剂&伤害翻倍，生命减少４０％&2","虚空符咒&移速增加３５，弹速减少１０&2","时空裂缝&射速增加６０，减伤减少４０％&3","幽灵之弹&子弹可穿透敌人数、反弹墙体数都增加１&3","极限爆发&伤害、减伤增加６０％&3","浴火重生&失败后复活一次，回复３０％血量并获得５层恢复和５层保护&3","嗜血诅咒&击败敌人时回复１０％血量&2","疾风闪击&击中敌人时有２０％的概率额外造成１次伤害，可叠加&2","迅影闪避&收到伤害时有２０％的概率免疫此次伤害&2","生命收割&击败区块内所有敌人后回复４０％血量&3","聚能爆发&子弹有２５％的概率爆炸，对周围敌人造成２倍伤害&3","连锁分裂&有２５％的概率发射３颗子弹&3","生命结晶&生命增加４５％并回满血量&2","金色命魂&攻击有３０％概率额外附加生命的５％的伤害&3","镜像分离&子弹击中敌人时有５０％概率朝反方向发射一颗子弹（触发限一次）&2","抗性诅咒&生命减少３０％减伤减少３０％&0","迟缓诅咒&移速减少２０、射速减少２０&0","力量诅咒&伤害减少３０％弹速减少２０&0","加成溃散&失去&0","加成溃散&失去&0","金色回声&收到伤害时对敌人附着２层眩晕&3","血脉觉醒&血量高于７０％时攻击额外附加６０％的伤害&2","子弹削弱&子弹可穿透敌人数减少１&0","子弹削弱&子弹可反弹墙体数减少１&0","庇护生机&开始战斗时获得５层恢复&2","迅捷之初&开始战斗时获得５层迅捷&2","守护庇佑&开始战斗时获得３层保护&2","后发制人&攻击有２５％概率额外向后发射子弹&2","随机附加&随机使子弹可反弹墙体数增加１或可穿透敌人数增加１&2","灼烧侵蚀&攻击时有３０％概率对敌人附着３层灼烧&2","眩目光辉&对敌人造成伤害时有２０％概率对敌人附着３层眩晕&2","破甲穿刺&对敌人造成伤害时有３０％概率对敌人附着４层破防&2","以命相搏&对敌人造成伤害时有２５％概率对敌人造成５倍伤害，但会对自身附加２层灼烧&3","自我突破&通关区域后生命、伤害、减伤增加１０％&2","自我觉醒&通关区域后生命、伤害、减伤额外增加１０％&3&52","自我升华&生命、伤害、减伤增加６０％，移速、射速、弹速增加４０&4","生命突破&战斗时血量可以突破至生命的２倍&3","迅敏电流&对敌人造成伤害时有１０％概率对自身附着３层迅捷&2","单打独斗&当场上只有１个敌人时伤害增加１００％&3","不死图腾&复活一次并回满血量，但未生效时开始战斗会获得５层灼烧和５层破防&3","震慑令敌&开始战斗时对全场敌人附着３层眩晕&2","重塑平衡&移速、射速、弹速重置为它们的平均值&2","力战群敌&场上每有１个敌人伤害附加５％&２","焰火之力&开始战斗时对全场敌人附着５层灼烧&2","逆转乾坤&血量第一次低于２０％时回复３０％的血量并获得５层迅捷&2","愈战愈勇&每战胜一个敌人伤害永久增加１％&2","幸运祝福&刷新的加成有２０％概率再提升一级品阶&3","烈焰风暴&攻击时有２５％概率对自身附着１层灼烧，对敌人附着４层灼烧&2","碎甲破敌&攻击时有３０％概率额外附加减伤的７倍伤害&3","疾风飞弹&弹速增加５０，减伤减少１５％&2","坚不可摧&减伤增加７５％生命减少２０％&2","势不可挡&伤害增加５０％并受到４０％生命的伤害&2","无阻飞弹&子弹可穿透敌人数增加１&2","幻影回旋&子弹可反弹墙体数增加１&2","力魄增幅&生命、伤害、减伤增加２４％&2","追风逐电&移速、射速、弹速增加１６&2","刚毅之魂&生命增加伤害属性&2","神秘宝匣&解锁更强力的普通加成选项&3","全视之眼&在地图中显示所有未探索的区块&2","生命提升&生命增加４５％&1&76","伤害提升&伤害增加４５％&1&76","减伤提升&减伤增加４５％&1&76","移速提升&移速增加３５&1&76","射速提升&射速增加３５&1&76","弹速提升&弹速增加３５&1&76","子弹改良&交换子弹的可穿透敌人数和可反弹墙体数&2","狂暴突袭&子弹必定击退敌人&3&9","领域探索&静止不动时扩大视野并根据鼠标位置移动摄像机&2&15","生命继承&在同一区域内血量可以突破至生命的２倍&3&55","天赐福缘&刷新的加成提升品阶概率提升至３５％&3&65","坚韧防线&生命增加减伤属性&2","新芽萌发&生命增加３０％&2","嫩枝生长&伤害增加３０％&2&90","枝繁叶茂&减伤增加３０％&2&91","蔚然成林&生命、伤害、减伤增加６０％&2&92","古木参天&生命、伤害、减伤增加６０％&3&93","净化奇草&加速眩晕、破防的消散速度&2","战意燃烧&减缓迅捷、保护效果的消散速度&2","随机替换&刷新加成&2","爆裂增生&将一并发射的３颗子弹升级为５颗子弹&3&30","生命之泉&每战胜一个敌人生命永久增加１％&2","披荆斩棘&每战胜一个敌人减伤永久增加３％&3","能量狂潮&子弹爆炸概率提升为５０％&3&29","能量升腾&子弹爆炸对周围敌人附加５层灼烧&3&29","荆棘屏障&返还１００％受到的伤害&2&10","荆棘回响&反伤时附加３层破防&2&10","背水一战&血量低于３０％时攻击额外附加６０％的伤害&2","镜影双生&子弹击中敌人时必定朝反方向发射一颗子弹（触发限一次）&3&33","生命屏障&单次受到的伤害不高于生命的２０％&4","弱点突破&移速、射速、弹速中最低一项增加４０&2","主导增幅&移速、射速、弹速中最高一项增加４０&2","钢铁意志&生命、伤害、减伤增加６０％，移速、射速、弹速减少４０&3","领域掌控&生命、