# =============================================================================
# K4Global.gd  ——  autoload 名 `K4Global`，extends Node
# =============================================================================
#
# 【调试体验说明（重要）】
# 转换器会按**工程实际声明**在这个文件里插入真实成员变量，例如：
#
#     var _v_分数 := 0
#     var _v_速度 := 0.0
#     var _l_列表: Array = []
#
# 生成代码**不直接拼这些名字**，而是一律走：
#
#     K4Global.设置("分数", 20)
#     var x = K4Global.取值("分数")          # 不要用 := 接，返回值是 Variant
#     K4Global.列表("道具").append("剑")
#
# 本文件内部用 `has()` / `get()` / `set()` 按名访问 → 对外一律是**中文原名**
# （`分数` 而不是 `_v_分数`），所以：
#   · 远程调试器的"节点属性"里直接能看到 `_v_分数 = 20` 的中文可读成员；
#   · 取值时"原名 → _v_原名 → 兜底字典"三级回落，改名规则变了也不会崩。
#
# 为什么不做成 `var 变量: Dictionary`？—— 那样调试器里只有一个折叠的大字典，
# 会毁掉调试体验（见设计规范 §3.2 的讨论）。
#
# 改名规则（与 积木映射.json 的 "改名.变量" 一致）：
#   K4 原名 S → 成员名 _v_S（列表 _l_S）
#   若 S 撞 Godot 成员/方法名或重名，生成器会再追加 `_2`、`_3` 后缀，
#   生成代码里的字符串也同步改成改写后的名字 → 这里不用管撞名。
# =============================================================================

extends Node

# —— 兜底容器：转换器还没来得及插入真实成员变量时用 ——
var _变量: Dictionary = {}
var _列表: Dictionary = {}

# 舞台/屏幕会话状态（背景切换、重置等要读）
var 当前背景: String = ""
var 当前屏幕: String = ""

# 前缀约定（生成器可改这里，改名规则只有一处）
#
# ★为什么带下划线★：K4 的标识符**不允许以 `_` 开头**，Godot 允许。
#   所以生成出来的成员一律冠 `_v_` / `_l_`，就与 K4 侧的任何名字天然隔离 ——
#   这是「K4 角色变量」和「方法参数/局部名」不可能撞名的**结构性**保证
#   （以前参数可以直接叫 `名`、成员也叫 `名`，撞上就静默遮蔽或直接报错）。
const 变量前缀 := "_v_"
const 列表前缀 := "_l_"

# =============================================================================
# 存在性判定
# =============================================================================
func _脚本属性(_名: String) -> bool:
	if _名 == "":
		return false
	var s = get_script()
	if s == null:
		return false
	for 项 in s.get_script_property_list():
		if String(项["name"]) == _名:
			return true
	return false

func 有(_名: String) -> bool:
	if _变量.has(_名) or _列表.has(_名):
		return true
	return _脚本属性(变量前缀 + _名) or _脚本属性(列表前缀 + _名)

func 是列表(_名: String) -> bool:
	if _列表.has(_名):
		return true
	return _脚本属性(列表前缀 + _名)

# =============================================================================
# 取值 / 设置
# =============================================================================
func 取值(_名: String) -> Variant:
	if _变量.has(_名):
		return _变量[_名]
	var 成员 := 变量前缀 + _名
	if _脚本属性(成员):
		return get(成员)
	# 3 级回落：也可能生成器直接按原名插了成员
	if _脚本属性(_名):
		return get(_名)
	if _列表.has(_名):
		return _列表[_名]
	return null

func 设置(_名: String, _值: Variant) -> void:
	if _变量.has(_名):
		_变量[_名] = _值
		return
	var 成员 := 变量前缀 + _名
	if _脚本属性(成员):
		set(成员, _值)
		return
	# 没声明就落进兜底字典（同时保证 取值 能取到）
	_变量[_名] = _值

func 全部变量() -> Dictionary:
	return _变量

# =============================================================================
# 列表
# =============================================================================
func 列表(_名: String) -> Array:
	if _列表.has(_名):
		return _列表[_名]
	var 成员 := 列表前缀 + _名
	if _脚本属性(成员):
		var 值 = get(成员)
		if 值 is Array:
			return 值
	# 取不到就创建并返回（并登记到兜底表，保证下次拿到同一个）
	var 新: Array = []
	_列表[_名] = 新
	if _脚本属性(成员):
		set(成员, 新)
	return 新

func 设置列表(_名: String, _值: Array) -> void:
	if _列表.has(_名):
		_列表[_名] = _值
		return
	var 成员 := 列表前缀 + _名
	if _脚本属性(成员):
		set(成员, _值)
		return
	_列表[_名] = _值

func 列表长度(_名: String) -> int:
	return 列表(_名).size()

func 清空列表(_名: String) -> void:
	列表(_名).clear()

# =============================================================================
# 会话重置（重新开始 / 换个屏幕）
# =============================================================================
func 重置会话状态() -> void:
	当前背景 = ""
	当前屏幕 = ""
