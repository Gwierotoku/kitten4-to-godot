# =============================================================================
# 帽子_屏幕切换.gd  ——  「当切换到当前屏幕时」
# =============================================================================
# K4 的块类型是 `on_running_group_activated`（运行组被激活）。
#
# 触发方式：**由游戏屏幕容器驱动** —— `K4Global.切换屏幕到()` 在切进某个屏幕时
#   遍历该屏幕的帽子并调用 `屏幕激活()`（基类虚方法），本帽子在这里重新跑一轮。
#   切走时基类会先调用 `取消运行()`（即走即取消），所以不会出现"上一轮还在跑、
#   这一轮又叠上去"的情况。
#
# 初始屏幕：容器 _ready 里就会切换一次，但那时本帽子的 `_已启动` 还没置真
#   （子节点 _ready 早于容器 _ready），所以 _ready 里补触发一次。
# =============================================================================

class_name 帽子_屏幕切换
extends 帽子基类

func _ready() -> void:
	if not await 让出帧(): return
	_已启动 = true
	if _触发条件满足() and _本屏幕当前():
		启动()

## ★只有原体响应「运行组被激活」★（与绿旗 `帽子_开始` 的判定完全对称）。
##   克隆体是"原体此刻的快照"，它跟着重跑会出两类大问题（实测）：
##     · 「当切换到当前屏幕 → 克隆自己」变成**自我复制**：切一次屏幕，
##       屏幕1 节点数 394 → 754，而且还在涨；
##     · 克隆体各自执行脚本开头的 `设置 屏幕1计数器 = 0` → 把原体正在累加的
##       全局计数器反复清零，观测上"计数器不涨"（实测卡在 2）。
func _触发条件满足() -> bool:
	return 角色 != null and not 角色.k4_is_clone

## 切进本屏幕 → 重新跑一轮（克隆体同样不参与，理由同上）
func 屏幕激活() -> void:
	if not _触发条件满足():
		return
	启动()
