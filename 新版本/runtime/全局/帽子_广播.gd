# =============================================================================
# 帽子_广播.gd  ——  「当接收到广播」
# =============================================================================
#
# 触发方式：K4Bus 的动态信号。
#
# 生成器写法（**不用**覆写 _ready，基类会在第一帧就调 _注册监听()）：
#
#     extends 帽子_广播
#     func _配置消息() -> String:
#         return "开始游戏"
#     func _积木主体() -> void:
#         var ctx = _上下文()
#         ...
#
# ---------------------------------------------------------------------------
# 【为什么消息名要读 _配置消息()】
#   生成器给广播帽子生成的是 `func _配置消息() -> String`（和 _配置键名 /
#   _配置方向 一个套路），而本文件以前读的是 `@export var 消息` ——
#   生成器既没写过这个属性、tscn 里也没有它，于是 `消息 == ""` →
#   **整个监听根本没注册**，「发送广播」的接收方永远收不到（静默不生效）。
#   现在优先读 `_配置消息()`，`@export 消息` 只作为兼容老工程/手填的退路。
#
# 【为什么注册要在第一帧、不等 process_frame】
#   同一帧里所有帽子的 `await process_frame` 续体按连接顺序恢复：靠前的角色先
#   启动、先广播，靠后的角色那时若还没注册就收不到。注册不依赖任何初始化，
#   所以放在 _ready 最前面（基类负责调用）。
# =============================================================================

class_name 帽子_广播
extends 帽子基类

# 兼容：老工程/手填时可以在编辑器里直接写消息名
@export var 消息: String = ""

# 事件在本帽子 _已启动 之前就到了（同一帧里靠前的角色广播）→ 先记下来补触发
var _待触发: bool = false

func _注册监听() -> void:
	if 角色 != null and not 角色.k4_is_clone:  #k4特性
		var 名 := _消息名()
		if 名 == "":
			return
		# 屏幕身份**不在注册时确定** —— 那一刻屏幕根脚本还没 _ready、K4Global 里还没
		# 登记本屏幕，算出来的会是上层节点。K4Bus 在**每次广播时**实时问监听者的
		# `_屏幕根()`（K4 的广播只在同一屏幕内传播）。
		K4Bus.监听(名, _收到广播)

## 消息名：优先生成器覆写的 _配置消息()，否则用 @export 的 消息
func _消息名() -> String:
	if has_method("_配置消息"):
		var 名 := String(call("_配置消息"))
		if 名 != "":
			return 名
	return 消息

## K4Bus 的监听回调（**同步**，只负责把本帽子这一轮点起来）。
##   ★它不能是"等待型"协程★：协程性要由 `_等本轮跑完()` 单独承担，
##   否则「发送广播并等待」会在广播过程中就挂起（等不到任何东西）。
func _收到广播() -> void:
	if _已启动:
		await 启动()
	else:
		# 同一帧里更靠前的角色已经广播了，而本帽子还没进入"已启动"状态 ——
		# 先记下来，等本帽子的 _ready 续体把 _已启动 置真后立刻补触发（见 _补触发）。
		#   ⚠ 不用 call_deferred：那要等到帧末，而"广播并等待"的发送方
		#   可能已经在等我们了（K4Bus 会先让出一帧再取等待钩子，两者能对上）。
		_待触发 = true

func _补触发() -> void:
	if _待触发:
		_待触发 = false
		await 启动()
