# =============================================================================
# 帽子_开始.gd  ——  「当开始被点击时」（绿旗帽子）
# =============================================================================
#
# 触发方式：默认行为即可 —— 帽子基类 _ready() 里 await 一个物理帧后启动。
#
# 两条 K4 语义：
#   ① 克隆体**不响应绿旗**（绿旗会先清掉所有克隆体）→ _触发条件满足() 判掉。
#   ② 再次点击绿旗 = 重启：编辑器/调试菜单可调 重启()，它会作废旧协程并
#      立刻开新协程（旧协程在下一个 await 角色.一步(ctx) 处自然退出）。
# =============================================================================

class_name 帽子_开始
extends 帽子基类

func _触发条件满足() -> bool:
	return 角色 != null and not 角色.k4_is_clone

## ★绿旗不受"当前屏幕"限制★（用户确认的 K4 语义）：
##   每个屏幕都是作品的一份独立运行组，点绿旗时各屏幕自己的绿旗脚本都要跑，
##   而不是"只有当前屏幕跑"。除此之外的帽子一律只在当前屏幕执行（见基类 启动()）。
func _屏幕无关() -> bool:
	return true

# 编辑器/调试用：重新点绿旗
func 重新点击绿旗() -> void:
	重启()
