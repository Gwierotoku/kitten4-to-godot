# =============================================================================
# 帽子_按键.gd  ——  「当按下 X 键」/「当松开 X 键」
# =============================================================================
# K4 的块类型是 `on_keydown`，字段形如：
#     {"key":"81","key_event_type":"up"}      ← 81='Q'，up=松开
#     {"key":"any","key_event_type":"down"}   ← 任意键
#
# 生成器把它写成一个覆写：
#     func _配置键名() -> String:   return "KEY_Q"
#     func _配置按键事件() -> String: return "up"
#
# ## ★这里曾经断线★（用户报"按键没法使用"）
# 生成器写的是 `_配置键名()`，而运行时的 `_input` 读的是 `@export var 键名` ——
# 两者从来没接上，于是 `键名` 恒为空串，键名解析把空串当成「任意键」：
# **按任何一个键都会触发全部 41 个按键帽子**（用户的作品叫《全按键类型》，
# 41 个键各一个帽子，症状就是"按什么都在乱触发 / 根本没按对"）。
# 现在：先读 `_配置键名()`，没有才退回 `@export 键名`（手改场景时用）。
#
# ## 现在的行为
#   · `_ready` 里**预编译**一次（键名 → 键码），`_input` 只做整数比较；
#   · 键名解析全部交给 `按键表`（与「按下 <键> 吗」侦测共用同一套真值）；
#   · 同时比对**逻辑键码**与**物理键码**（不同键盘布局下可能只有一个对上）；
#   · 键名空 / 认不出来 → **不触发**（不再误当任意键）；
#   · 只认 K4 指定的那一档（按下 / 松开），长按的自动重复（echo）照收 ——
#     浏览器里 keydown 也会重复发，这与 K4 行为一致。
# =============================================================================

class_name 帽子_按键
extends 帽子基类

## 手改场景 / 老产物用的键名字段；生成器产物走 `_配置键名()` 覆写
@export var 键名: String = ""

## 编译结果（_ready 时算一次）
var _目标名: String = ""
var _目标码: int = KEY_NONE
var _要松开: bool = false
var _是任意键: bool = false
var _已配置: bool = false


func _ready() -> void:
	_编译()
	await super._ready()


## 生成器覆写：返回 K4 的键名（"KEY_Q" / "KEY_LEFT" / "any"）
func _配置键名() -> String:
	return ""

## 生成器覆写：返回 "down"（按下，默认）或 "up"（松开）
func _配置按键事件() -> String:
	return "down"


func _编译() -> void:
	_目标名 = _配置键名().strip_edges()
	if _目标名 == "":
		_目标名 = 键名.strip_edges()        # 退回场景里配的那个
	_要松开 = _配置按键事件().to_lower() == "up"
	_是任意键 = 按键表.是任意键(_目标名)
	_目标码 = 按键表.解析(_目标名)          # ★解析一次，_input 只做整数比较★
	_已配置 = 按键表.是已配置(_目标名)
	if not _已配置:
		# 键名没配 / 认不出来：宁可不动，也不要变成"任意键全触发"
		push_warning("帽子_按键：键名 [%s] 认不出来，这个帽子不会触发（角色=%s）" %
			[_目标名, str(角色.name) if 角色 != null else "?"])


func _input(_event: InputEvent) -> void:
	if 角色 != null and not 角色.k4_is_clone:  #k4特性
		if not _已配置 or 角色 == null:
			return
		if not (_event is InputEventKey):
			return
		if 按键表.事件匹配(_event as InputEventKey, _目标码, _是任意键, _要松开):
			启动()
