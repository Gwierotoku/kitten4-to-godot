# =============================================================================
# 帽子_条件.gd  ——  「当满足条件」（K4 的 when 积木）
# =============================================================================
#
# 触发方式：_process 轮询。**两种语义，本文件管 while 型**：
#
#   · while 型（本文件默认，K4 的「当满足条件」）：
#       条件为真就一直执行 —— 脚本体跑完后，只要条件**仍然为真**就接着再跑
#       一轮，直到条件为假。**不看"上一帧是真是假"**。
#   · 边沿型（子类把 _循环触发() 覆写成 false）：
#       条件由假变真才启动一次（「当计时器 > N」「当响度 > N」）。
#
#   ★为什么阈值型必须是边沿★
#     计时器只增不减、响度越过阈值后也常年成立 —— 若按 while 型处理，
#     条件一旦成立就是**永不停歇的循环**，等于把作品锁死。
#     所以两种语义共存，靠 _循环触发() 区分。
#
#   生成器子脚本写法：
#       extends 帽子_条件
#       func _条件() -> bool:
#           return 角色.坐标("x") > 100.0     # 原积木: 当()>() @xxx
#       func _积木主体() -> void:
#           var ctx = _上下文()
#           ...
#
#   也可以不改脚本、只在编辑器里填表达式：
#       @export var 条件函数: Callable
#
# 【为什么 while 型是"每帧最多一轮"而不是同一帧连转】
#   条件恒真、脚本体又全是同步积木（warp 里不让出）时，同一帧连转会变成
#   **同步死循环**：主线程被占死，编辑器和窗口都"未响应"（见 一步() 里
#   那段"运行一会就未响应"的注释）。放在 _process 里就天然带上了"每轮之间
#   让出一帧"：脚本再快也是隔帧再启动一轮；而脚本体自己该让出的地方
#   （一步 / 等待）照旧让出，节奏不受影响。
#
# 【与"运行中不重入"的关系】
#   启动() 里有 `if _运行中: return`：上一轮没跑完时，新一轮一律不叠加。
#   所以 while 型这里是"跑完 → 下一帧条件仍真 → 再跑一轮"，
#   不是"同一帧里叠 N 轮"，也不会出现两个协程同时跑同一段积木。
# =============================================================================

class_name 帽子_条件
extends 帽子基类

# 可选：编辑器里填一个返回 bool 的 Callable（生成器一般不用，走 _条件() 覆写）
@export var 条件函数: Callable = Callable()

# 上一帧条件是否为真 —— **只有边沿型看它**（while 型不看）
var _上次为真: bool = false

func _ready() -> void:
	if 角色 != null and not 角色.k4_is_clone:  #k4特性
		if not await 让出帧(): return
		_已启动 = true
		# 初始帧不触发（K4 创建当帧不执行）：
		#   边沿型把"创建那一刻的条件"记为已触发过 —— 于是条件一开始就为真
		#   也不会在下一帧立刻启动，要等它先变假再变真。
		#   while 型不看这个标志，所以这里**不去求值条件**（条件表达式可能有
		#   副作用：生成器会把跨角色调用之类的积木放进 _条件() 里）。
		if not _循环触发():
			_上次为真 = _取条件()
		set_process(true)

func _process(_delta: float) -> void:
	if not _已启动:
		return
	if _循环触发():
		# while 型：**只在一轮开始前判条件**（正是 while 的语义）。
		# 上一轮还在跑时连条件都不去求值：既省掉每帧一次条件表达式
		# （生成器会把跨角色调用之类的积木塞进 _条件() 里，那是有副作用的），
		# 也避免拿"运行期间的条件"去影响下一轮的判定。
		if not _运行中 and _取条件():
			启动()
		return
	# 边沿型：只在"假 → 真"这一帧启动
	var 本帧 := _取条件()
	if 本帧 and not _上次为真:
		启动()
	_上次为真 = 本帧

## 触发语义：true = while 型（条件为真就一直跑，跑完若条件仍真则接着跑）；
##           false = 边沿型（条件由假变真只跑一次）。
##
## ★阈值型子类（帽子_计时器 / 帽子_响度）必须覆写成 false★
##   理由见文件头："计时器 > N" 一旦成立就永远成立。
func _循环触发() -> bool:
	return true

# 子类覆写这个
func _条件() -> bool:
	return false

func _取条件() -> bool:
	if 条件函数.is_valid():
		return bool(条件函数.call())
	return _条件()
