# =============================================================================
# 帽子_计时器.gd  ——  「当计时器 > N」
# =============================================================================
#
# 触发方式：同 帽子_条件 —— _process 轮询 + 边沿触发。
#   _条件() = 角色.计时器() > 阈值
#
# @export var 阈值: float   ← 生成器写 N
#
# 计时器归属：K4/Scratch 的计时器是**每个角色一份**（角色基类.k4_timer，
#   由 角色基类._process 每帧累加），所以这里读 角色.计时器()。
#   若某工程确认是舞台级共享计时器，改这一处即可。
# =============================================================================

class_name 帽子_计时器
extends 帽子_条件

@export var 阈值: float = 1.0

func _条件() -> bool:
	if 角色 == null:
		return false
	return 角色.计时器() > 阈值
