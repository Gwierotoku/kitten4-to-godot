# =============================================================================
# 帽子_计时器.gd  ——  「当计时器 > N」
# =============================================================================
#
# 触发方式：_process 轮询 + **边沿触发**（_循环触发() 覆写为 false）。
#   _条件() = 角色.计时器() > 阈值
#
#   ★为什么不是 while 型★
#     计时器只增不减，"计时器 > N"一旦越过就永远为真 —— 按 while 型处理会变成
#     永不停歇的循环（脚本体跑完立刻又跑，永远停不下来）。
#     K4 里这一族是"跨过阈值的瞬间触发一次"，所以走边沿。
#
# @export var 阈值: float   ← 生成器写 N
#
# 计时器归属：K4/Scratch 的计时器是**每个角色一份**（角色基类.k4_timer，
#   由 角色基类._process 每帧累加），所以这里读 角色.计时器()。
#   若某工程确认是舞台级共享计时器，改这一处即可。
# =============================================================================

class_name 帽子_计时器
extends 帽子_条件

@export var 阈值: float = 1.0

## ★边沿型★（语义见 帽子_条件._循环触发 的注释）：只在跨过阈值那一刻启动一次，
## 之后计时器继续变大也不再重复启动，除非它先掉回阈值以下（正常不会）。
func _循环触发() -> bool:
	return false

func _条件() -> bool:
	if 角色 == null:
		return false
	return 角色.计时器() > 阈值
