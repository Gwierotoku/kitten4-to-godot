# =============================================================================
# 帽子基类.gd  ——  所有事件积木（帽子）的基类
# =============================================================================
#
# 继承链：帽子基类.gd → 各帽子（帽子_开始 / 帽子_广播 / …）
#         → 生成器为每个帽子生成的 <帽子名>_N.gd（只覆写 _积木主体()）
#
# ---------------------------------------------------------------------------
# 【契约 A】async/sync 分工（这不是风格问题，是 Godot 4 分析器的硬规则）
# ---------------------------------------------------------------------------
#   Godot 4 的 GDScript 分析器有两条互斥的警告：
#     · MISSING_AWAIT     ：调用了协程却没 await
#     · REDUNDANT_AWAIT   ：await 了一个**静态可判定为非协程**的表达式
#   而**协程性是按声明（含基类实现）静态判定的**：
#     func _积木主体() -> void: pass            → 分析器认定"非协程"
#     func _积木主体() -> void: await xxx       → 分析器认定"协程"
#   子类把 pass 覆写成协程，**不会**改变基类实现的判定结果。
#
#   因此本文件确立两条不可动摇的规则：
#
#     ★ _积木主体() 一律是**协程**（基类实现里就带 await），
#       调用方一律写 `await _积木主体()`；子类覆写时必须含 await。
#
#     ★ 启动() / 重启() 一律是**同步函数**，内部用
#       `call("_积木主体")` 点火（显式丢弃协程句柄 → 后台协程）。
#       调用方（_ready / _input / _process / K4Bus）**一律不写 await**。
#       ——帽子积木体本来就是"后台线程"语义（K4 的事件线程），
#         调用点不该等它跑完，这正是 K4 的行为。
#
#   为什么点火用 call("_积木主体") 而不是直接 `_积木主体()`：
#     直接调用协程会触发 MISSING_AWAIT（在开启该警告的工程里会变成 error）。
#     走 call() 的返回值是 Variant，分析器无法判定协程性 → 0 warning，
#     而且语义完全一样（协程照样跑起来，句柄由引擎持有）。
#
# ---------------------------------------------------------------------------
# 【契约 B】_上下文() 而不是 角色.新建上下文()
# ---------------------------------------------------------------------------
#   生成代码请写：`var ctx = _上下文()`
#   原因：绿旗重启时基类要把**旧协程**标记作废，而"作废"标记必须落在
#   旧协程持有的那个 ctx 对象上。若生成代码自己 角色.新建上下文()，
#   旧协程就作废不掉，会变成两个协程同时跑同一段积木。
#   （warp 语义 / 进入warp / 退出warp 的用法完全不变。）
#
# ---------------------------------------------------------------------------
# 【契约 C】重置任务（事件型帽子的非重入）
# ---------------------------------------------------------------------------
#   基类 _ready() 里 await 一帧后调用 _周期任务()（虚方法，默认空）。
#   条件/计时器/响度/背景切换这些"轮询型"帽子覆写 _周期任务() 做边沿检测。
#   注意：**不要**覆写 _process()，否则会顶掉 角色基类 的计时器累加逻辑链路。
# =============================================================================

class_name 帽子基类
extends Node2D

# 角色节点（角色的根节点脚本 extends 角色类）
@onready var 角色: 角色类 = get_parent() as 角色类

# 本次运行的 warp 上下文（由 _上下文() 暴露给生成的 _积木主体()）
var _ctx: 角色基类.WarpCtx = null
# 上一次运行的上下文（重启时用来作废旧协程）
var _旧ctx: 角色基类.WarpCtx = null
# 积木主体是否正在运行
var _运行中: bool = false
# 本帽子是否已过 _ready 阶段
var _已启动: bool = false
# 点火次数（每跑一轮 +1）。给**调试和自动化验证**用：
#   「按键帽子到底有没有被这个按键触发」在 headless 里没法看画面，
#   但 `帽._触发次数` 一看就知道 —— 见 _dev/key_check.gd。
var _触发次数: int = 0

# 跑完一个积木主体时发出（K4Bus的"发信号并等待"靠它）
signal _跑完

# -----------------------------------------------------------------------------
# _ready：等父节点 _ready 完成（Godot 的 _ready 是子先父后）再启动
# -----------------------------------------------------------------------------
func _ready() -> void:
	# ★注册要抢在**第一帧**就完成★
	#   广播可能在同一帧稍后到达：所有帽子的 `await process_frame` 续体在同一帧按
	#   连接顺序恢复，靠前的角色（n1）先启动并广播，此时靠后的角色（n3）如果还没
	#   注册监听，事件直接丢 —— 实测「广播测试」工程就是这样（n3 永远收不到）。
	#   注册本身不需要等任何东西，所以放在最前面。
	_注册监听()
	await get_tree().process_frame
	_已启动 = true
	if _触发条件满足():
		启动()
	_周期任务()
	# ★补触发★：给"注册得早、事件来得也早"的帽子一个补救点 ——
	#   广播帽子在第一帧注册监听，同帧里靠前的角色先启动并广播，那时本帽子
	#   还没 _已启动，于是先把事件记下；本方法在 _已启动 之后就地把事件补上。
	_补触发()

# 子类可覆写：把本帽子的"事件来源"接上（广播帽子在这里 K4Bus.监听）。
func _注册监听() -> void:
	pass

# 子类可覆写：处理"事件早于 _已启动 到达"的补触发（默认什么都不做）
func _补触发() -> void:
	pass

## 本帽子所在的**屏幕根** —— 当"屏幕身份"用（广播分屏 + 屏幕限定都靠它）。
##   ★判定顺序★：
##     ① 向上找**已登记的屏幕节点**（屏幕脚本 _ready 里 K4Global.登记屏幕 的那个）
##        —— 不管屏幕场景挂在容器下、root 下、还是别的节点下，都能对上；
##     ② 还没登记（屏幕脚本 _ready 之前）时退回结构判断：
##        游戏屏幕容器的直接子节点，或 root 的直接子节点。
##
##   ⚠ **不要缓存结果**：帽子的 _ready（注册监听）早于屏幕根脚本的 _ready，
##     那一刻屏幕还没登记，算出来的会是"检查脚本/容器"之类的上层节点；
##     一旦缓存，后面所有判定（广播分屏、屏幕限定）都会用错的屏幕身份。
##     表很小（屏幕数量级），每次实时算的代价可以忽略。
func _屏幕根() -> Node:
	var 树 := get_tree()
	if 树 == null:
		return null
	var 表: Dictionary = {}
	if K4Global != null and K4Global.get("屏幕节点") != null:
		表 = K4Global.屏幕节点
	var 根: Node = self
	while 根 != null:
		for k in 表.keys():
			if 表[k] == 根:
				return 根
		根 = 根.get_parent()
	var 容器: Node = (K4Global.游戏屏幕 if K4Global != null else null)
	根 = self
	while 根.get_parent() != null:
		var 父 := 根.get_parent()
		if 父 == 树.root:
			return 根                                  # 旧架构：屏幕场景直接挂 root
		if 容器 != null and is_instance_valid(容器) and 父 == 容器:
			return 根                                  # 游戏屏幕容器架构
		根 = 父
	return 根

# 子类可覆写：**「脚本一挂上就该跑」的帽子**才返回 true。
#
#   ★默认必须是 false★
#   只有两类帽子该在 _ready 时就跑：
#     · 帽子_开始       —— 「当开始被点击时」（绿旗）
#     · 帽子_克隆启动   —— 「当作为克隆体启动时」
#   其余全是**事件型/轮询型**，必须等事件或等自己的 _period 检测：
#     · 帽子_按键 / 帽子_点击 / 帽子_广播   → 等输入、等信号
#     · 帽子_条件 / 帽子_计时器 / 帽子_响度 → 自己的 _process 里边沿触发
#     · 帽子_屏幕切换 / 帽子_背景切换       → 等屏幕信号
#
#   ⚠ 这里以前默认返回 true。帽子_按键 既没覆写本方法、也没覆写 _ready()，
#     于是**一进场景就把「当按下 X 键」的积木体跑了一遍**（phi 转换器里
#     表现为"没按 S 就执行、还报了个看起来无关的算术错"）。
#     默认改成 false 之后，将来再有人加新帽子忘了覆写，也只是"不触发"，
#     不会"乱触发"——错误方向选安全的那一边。
func _触发条件满足() -> bool:
	return false

# 子类可覆写：轮询型帽子的每帧任务（默认什么都不做）
func _周期任务() -> void:
	pass

# -----------------------------------------------------------------------------
# 生成器只覆写这一个方法 —— 注意它**必须是协程**（含 await）
# -----------------------------------------------------------------------------
func _积木主体() -> void:
	# 基类实现刻意保留一个 await，让分析器判定"这是协程"：
	#   → 子类覆写成协程不会被报 REDUNDANT_AWAIT
	#   → `await _积木主体()` 永远合法
	await get_tree().process_frame

# -----------------------------------------------------------------------------
# 启动 / 重启（同步函数：点火后立刻返回，积木体在后台协程里跑）
# -----------------------------------------------------------------------------
func 启动() -> void:
	if not _已启动:
		return
	# ★屏幕限定★（K4 语义，用户确认）：
	#   游戏屏幕容器里**所有屏幕的场景同时存在**（只是不可见），
	#   如果不拦，非当前屏幕的角色也会响应按键/点击/广播/条件……
	#   所以除「当开始被点击时」「当作为克隆体启动时」之外，一律只在
	#   "自己所在屏幕 == 当前屏幕"时才启动。
	if not _本屏幕当前():
		return
	if _运行中:
		return          # 事件型帽子不重入；绿旗走 重启()
	_点火()

# 子类可覆写：本帽子是否**不受**屏幕限定（只有绿旗 / 克隆体启动是）
func _屏幕无关() -> bool:
	return false

# 本帽子此刻是否位于"当前屏幕"上（见 _屏幕根()）
func _本屏幕当前() -> bool:
	if _屏幕无关():
		return true
	return K4Global.屏幕是否当前(_屏幕根())

# -----------------------------------------------------------------------------
# 屏幕切走 / 切回（K4 的运行组语义，用户确认）
#   · 非全局帽子（除绿旗、克隆体启动外全部）：「即走即取消」——
#     屏幕被切走时，**正在跑的协程立刻作废并收尾**（不留下后台循环继续克隆/计算）；
#   · 切回该屏幕时：`屏幕激活()` 被调用，由各帽子决定"要不要重新开始一轮"
#     （「当切换到当前屏幕」就是在这里重新跑；事件型帽子什么都不做，等事件即可）。
#   全局帽子（绿旗 / 克隆体启动）两边都不参与 —— 它们要在所有屏幕都跑。
# -----------------------------------------------------------------------------

## 屏幕被切走时调用：取消本帽子的运行中协程。
## ⚠ 必须走 `_结束运行()` 而不是只改标志位：它会把 `_运行中` 落回 false（这样
##   切回来还能重新点火）、并 emit `_跑完`（否则正在「广播并等待」的发送方
##   会永远等一个再也不会结束的协程）。
func 取消运行() -> void:
	if _屏幕无关():
		return                       # 绿旗 / 克隆体启动：不参与屏幕生命周期
	if _ctx != null:
		_ctx._已取消 = true          # 旧协程会在下一个让出点（一步/等待…）自行退出
	_结束运行()

## 屏幕被切回（或被激活）时调用：默认什么都不做。
## 需要"切进来就重新开始"的帽子（当切换到当前屏幕）覆写它。
func 屏幕激活() -> void:
	pass

# 绿旗重启：作废旧协程 + 立刻开新协程（「当开始被点击时」用）
func 重启() -> void:
	if _ctx != null:
		_ctx._已取消 = true
	_ctx = null
	_点火()

func _点火() -> void:
	_触发次数 += 1
	_ctx = 角色基类.WarpCtx.new()
	_运行中 = true
	# 同样按名调用（_跑主体 是协程，直接调会触发 MISSING_AWAIT）
	call("_跑主体")

# 单独一层协程：跑完把 _运行中 落回 false。
#
#   ★以前 _点火() 直接 call("_积木主体") 就完事了，_运行中 永远是 true★
#   而 启动() 开头就是 `if _运行中: return` —— 于是所有事件型帽子
#   （按键 / 点击 / 广播）**只能触发第一次**，之后再按再点都没反应。
#   这是"触发条件对不对"里最要命的一条。
#
#   用 `var 本轮 := _ctx` 比对，是为了让绿旗重启（重启() 会换一个新 ctx）
#   时，旧协程跑完**不要**把新一轮的 _运行中 抹掉。
func _跑主体() -> void:
	var 本轮: 角色基类.WarpCtx = _ctx
	await call("_积木主体")
	if _ctx == 本轮:
		_结束运行()

# 供生成的 _积木主体() 取本次运行的 warp 上下文
func _上下文() -> 角色基类.WarpCtx:
	if _ctx == null:
		_ctx = 角色基类.WarpCtx.new()
		_运行中 = true
	return _ctx

# 积木体跑完时由 一步() 之外的路径调用；生成器一般不用管。
func _结束运行() -> void:
	_运行中 = false
	_旧ctx = _ctx
	_ctx = null
	_跑完.emit()

# K4Bus用的等待点：等这个帽子当前这一轮积木体跑完
#
#   ★为什么不能写成 `await 启动()`★（以前 帽子_广播.gd 就是这么覆写的）：
#   启动() 是**同步函数**，内部 `call("_积木主体")` 把协程点着就立刻返回 ——
#   `await 启动()` 等到的只是"已经点火"，不是"跑完"。于是 K4 的
#   「发送广播并等待」退化成「发送广播」，测试工程里表现为：
#   n1 广播并等待 → n3 的抖动还没跑完，n1 就已经继续往下广播"测试"。
#   正确做法：等 `_跑完` 信号（它在 _结束运行() 里发出，那时 _运行中 落回 false）。
func _等本轮跑完() -> void:
	while _运行中:
		await _跑完

# 让子类判断角色是否可用
func _角色可用() -> bool:
	return 角色 != null and 角色.k4_alive
