# =============================================================================
# 游戏屏幕.gd  ——  「游戏屏幕」容器
# =============================================================================
# 转换器会在 全局/ 下生成 `游戏屏幕.tscn`（挂本脚本），结构是：
#
#     游戏屏幕 (Node2D + 本脚本)
#       ├─ 屏幕A (屏幕A.tscn 的实例)
#       ├─ 屏幕B (屏幕B.tscn 的实例)
#       └─ …（按 K4 的屏幕顺序）
#
# 只有**当前屏幕** visible = true。project.godot 的主场景就是它。
#
# ★为什么不用 change_scene_to_file★
#   · K4 的「屏幕」= 运行组：切屏幕**不该销毁**另一组的状态（变量、克隆体、
#     角色位置、广播监听都留着），所以所有屏幕场景一开始就都在树里；
#   · 只有所有屏幕同时在树里，"每个屏幕的广播各自独立"才需要（也才能）按
#     屏幕根过滤 —— K4Bus 用屏幕根当身份，正好对上；
#   · 切屏幕 = 只改可见性 + 当前屏幕名 + 画布指向，代价极小，也不会有换场景
#     那一帧的丢帧/丢事件。
#
# ★屏幕限定★
#   非当前屏幕里，除「当开始被点击时」「当作为克隆体启动时」之外的帽子
#   一律不执行（帽子基类.启动() 里拦），所以不可见的屏幕不会响应按键/点击。
# =============================================================================

extends Node2D

func _ready() -> void:
	K4Global.游戏屏幕 = self
	# 初始屏幕 = K4 屏幕顺序里的第一个（转换器按同一顺序放子节点）
	var 首 := ""
	if K4Global.屏幕顺序.size() > 0:
		首 = str(K4Global.屏幕顺序[0])
	if 首 == "":
		# 兜底：拿第一个登记过的屏幕
		for k in K4Global.屏幕节点.keys():
			首 = str(k)
			break
	if 首 != "":
		K4Global.切换屏幕到(首)
	else:
		push_warning("游戏屏幕：没有登记任何屏幕（转换器没生成屏幕场景？）")
