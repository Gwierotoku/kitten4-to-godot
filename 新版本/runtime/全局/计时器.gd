# =============================================================================
# 计时器.gd  ——  autoload 名 `K4Timer`，extends Node
# =============================================================================
#
# ============================ 为什么必须是全局单例 ============================
#
# K4（和 Scratch 一样）整个作品**只有一个计时器**：舞台上任何一个角色读到的
# 「计时器」都是同一个值，「重置计时器 / 停止计时器」也影响**所有**角色。
#
# 以前这份状态放在 `角色基类` 上（`var k4_timer` / `k4_timer_running`），
# 于是**每个角色、每个克隆体各存一份**：
#   · A 角色重置计时器 → B 角色的计时器照旧在走（K4 里 B 也会被归零）
#   · 一堆克隆体各跑一个 _process 累加，白烧 CPU（N 个克隆体 = N 份计时）
#   · 克隆体刚出生时读到的是自己那份 0.0，而不是作品的真实计时
#
# 所以计时器状态整体搬到这个 autoload，`角色基类` 里的
# 计时器() / 开始计时器() / 停止计时器() / 重置计时器() 全部改为委托到这里。
# 生成代码（`await 角色.计时器()`）一个字都不用改。
#
# ⚠ 为什么单独一个 autoload，而不是并进 `全局变量.gd`（K4Global）？
#   因为 `全局/全局变量.gd` 是**每次转换都会覆盖**的生成文件
#   （里面的全局变量成员由生成器按工程声明插进去）。
#   计时器属于运行时库，放进去会被下一次转换清掉 —— 所以必须独立成文件。
# =============================================================================

extends Node

# —— 计时器状态（全作品唯一一份）——
var 计时: float = 0.0
var 在走: bool = true

func _process(_delta: float) -> void:
	if 在走:
		计时 += _delta

# —— 「计时器」积木：读当前秒数 ——
func 取值() -> float:
	return 计时

# —— 「开始计时器」：继续走（不动已累计的时间）——
func 开始() -> void:
	在走 = true

# —— 「停止计时器」：冻结在当前位置 ——
func 停止() -> void:
	在走 = false

# —— 「重置计时器」：归零（**不改变**走/停状态，与 K4 一致）——
func 重置() -> void:
	计时 = 0.0

# —— 「把计时器设为 X 秒」：K4 的 set_timer_state 还有直接赋值的形态 ——
func 设值(_秒: Variant) -> void:
	if _秒 is String and not (_秒 as String).is_valid_float():
		return
	计时 = maxf(0.0, float(_秒))

# —— 「重新开始」/「切换屏幕」时由会话重置调用 ——
func 重置会话状态() -> void:
	计时 = 0.0
	在走 = true
