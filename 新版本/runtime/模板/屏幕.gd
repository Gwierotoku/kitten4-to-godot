# =============================================================================
# 屏幕.gd  ——  ★设计参考稿：转换器**不拷贝**这个文件★
# =============================================================================
# 真正生成的是 emit.js 里的 emitSceneScript()，它只写两行：
#     func _ready() -> void:
#         K4Canvas.设置画布($屏幕绘制)
#         K4Global.当前屏幕 = "<K4 屏幕名>"
# 本文件保留下来只为了说明节点树长什么样、坐标系怎么对齐。
# 下面那些 signal / 舞台底色 / 切换背景 是**待接的扩展点**，
# 目前没有生成出来（背景切换走 广播总线，见 帽子_背景切换.gd）。
#
# 挂在这个节点树上：
#
#   Scene: Node2D（屏幕）  ← 屏幕根脚本
#   ├─ 屏幕绘制（Node2D + 屏幕绘制.gd）   ← 必须是第一个子节点（画在角色后面）
#   ├─ 基础角色层（Node2D）               ← local (0,0) = 舞台中心
#   │  └─ 角色（Node2D + 角色脚本.gd）
#   │     ├─ customs / 造型1 / 造型2…
#   │     └─ 各帽子子节点
#   └─ 克隆体层（Node2D）
#
# 坐标系（重要）：
#   project.godot 里 viewport 尺寸 = K4 舞台尺寸，stretch=canvas_items/keep，
#   所以「舞台坐标系 == 视口坐标系」，原点在舞台左上角：
#     · 屏幕绘制：留在 (0,0)、scale 为 1，直接按舞台坐标画
#     · 基础角色层：position = 视口尺寸 * 0.5  → 舞台中心
#     · 角色：position = (k4_x, -k4_y)（K4 原点居中、y 轴向上）
# =============================================================================

extends Node2D

signal 屏幕已就绪
signal 屏幕背景切换(背景名: String)

# 舞台底色（屏幕绘制节点会读它当背景板颜色）
@export var 舞台底色: Color = Color.WHITE

func _ready() -> void:
	# ① 接上画布调度（画布节点 = 屏幕的第一个子节点）
	画布调度.画布 = $屏幕绘制
	# ② 登记当前屏幕名（帽子/背景切换要用）
	var 屏幕名 := String(name)
	全局变量.当前屏幕 = 屏幕名
	if 全局变量.当前背景 == "":
		全局变量.当前背景 = 舞台底色.to_html(false)
	# ③ 通知所有「当切换到当前屏幕时」帽子
	#    用 call_deferred：保证这一帧里所有节点的 _ready 都跑完再 emit，
	#    帽子那边（_ready 里 await 一帧后 connect）一定能收到。
	屏幕已就绪.emit.call_deferred()

# 背景切换：屏幕自己改背景色 + 广播（「当背景切换为 X」帽子听这个信号）
func 切换背景(_背景名: String) -> void:
	全局变量.当前背景 = _背景名
	屏幕背景切换.emit(_背景名)

# 舞台中心（K4 坐标：原点居中）→ Godot 位置
func 舞台中心() -> Vector2:
	return get_viewport_rect().size * 0.5
