	pass

func 设置质量(_值: float) -> void:
	pass

func 设置弹性(_值: float) -> void:
	pass

func 设置重力(_值: float) -> void:
	pass

# -----------------------------------------------------------------------------
# 取值方法桩：必须返回该类型的默认值
# -----------------------------------------------------------------------------
func 坐标(_轴: String) -> float:
	return 0.0

func 方向() -> float:
	return 0.0

func 大小() -> float:
	return 0.0

func 当前造型() -> String:
	return ""

func 是否可见() -> bool:
	return false

func 克隆体数量() -> float:
	return 0.0

# -----------------------------------------------------------------------------
# 等待方法桩（有 await，生成器调用处也必须 await）
# -----------------------------------------------------------------------------
func 等待_秒(_ctx: 角色基类.WarpCtx, _秒: float) -> void:
	pass
